# Copy to .env if you want to override defaults.
LOCAL_MEETSCRIBE_DATA_DIR=./data
LOCAL_MEETSCRIBE_MODELS_DIR=./models
LOCAL_MEETSCRIBE_ALLOW_MOCKS=true
LOCAL_MEETSCRIBE_ALLOW_MODEL_AUTODOWNLOAD=false
LOCAL_MEETSCRIBE_FFMPEG=ffmpeg
LOCAL_MEETSCRIBE_FFPROBE=ffprobe
LOCAL_MEETSCRIBE_FASTER_WHISPER_CPU_MODEL=small
LOCAL_MEETSCRIBE_FASTER_WHISPER_CUDA_MODEL=turbo
LOCAL_MEETSCRIBE_FASTER_WHISPER_CPU_THREADS=0

# Required only for first download/use of gated pyannote models.
HF_TOKEN=

# Optional local-only Ollama-compatible cleanup/minutes endpoint.
LOCAL_MEETSCRIBE_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MEETSCRIBE_OLLAMA_MODEL=qwen3:8b
LOCAL_MEETSCRIBE_ENABLE_LLM_CLEANUP=false

# Optional cloud transcription. Off by default because the normal pipeline is local-first.
LOCAL_MEETSCRIBE_ENABLE_GEMINI_TRANSCRIPTION=false
GEMINI_API_KEY=
LOCAL_MEETSCRIBE_GEMINI_MODEL=gemini-3.5-flash
LOCAL_MEETSCRIBE_GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Protect internet/LAN API requests with a short-lived session issued after passcode verification.
LOCAL_MEETSCRIBE_REMOTE_ACCESS=false
LOCAL_MEETSCRIBE_REMOTE_SESSION_TTL_SEC=7200
LOCAL_MEETSCRIBE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional completed TXT copy folder. The network startup script uses ~/Downloads/PhoneScribe.
LOCAL_MEETSCRIBE_AUTO_EXPORT_DIR=

# Optional Supabase recording/transcript persistence. Prefer the DPAPI-backed
# `local-meetscribe supabase configure --url https://PROJECT.supabase.co` command
# on Windows instead of keeping the service credential in this file.
LOCAL_MEETSCRIBE_SUPABASE_ENABLED=false
LOCAL_MEETSCRIBE_SUPABASE_URL=
LOCAL_MEETSCRIBE_SUPABASE_SERVICE_ROLE_KEY=
LOCAL_MEETSCRIBE_SUPABASE_OWNER_ID=
LOCAL_MEETSCRIBE_SUPABASE_PART_SIZE_BYTES=6291456
LOCAL_MEETSCRIBE_SUPABASE_MAX_RECORDING_BYTES=4294967296
